#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Builds the boot floppy and the root
# hard-disk image for the selected platform. Mirrors the platform Makefile's
# image/diskimage rules.
#
#   boot.dsk   = boot sector padded to a 256256-byte floppy, kernel written at
#                track 58 (byte offset 193024), skipping the kernel image's
#                low @DISK_SKIP@ bytes (the load origin).
#   drivep.dsk = 512MB disk with the root filesystem written at the start.
# ---------------------------------------------------------------------------
set -e

LD='@FUZIX_LD@'
PLATDIR='@PLATFORM_DIR@'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FSIMG='@FUZIX_FILESYS_IMG@'
WORK='@DISKIMAGE_WORK@'
SKIP='@DISK_SKIP@'

mkdir -p "$IMGDIR" "$WORK"

# 1. Assemble + link the boot sector (assembler is CPU-specific).
# Options must precede operands: a BSD/macOS getopt() stops scanning at the
# first non-option, so "-o bootblock.bin" has to come before bootblock.o.
( cd "$WORK" && @CPU_BOOTBLOCK_ASSEMBLE@ && "$LD" -b -o bootblock.bin bootblock.o )

# 2. Boot floppy: boot sector padded to a full 256256-byte disk, kernel at
#    track 58 (byte offset 193024).
dd if="$WORK/bootblock.bin" of="$IMGDIR/boot.dsk" bs=256256 conv=sync
dd if="$KIMAGE" of="$IMGDIR/boot.dsk" bs=1 skip="$SKIP" seek=193024 conv=notrunc

# 3. Root hard disk: 512MB, root filesystem (if provided) written at offset 0.
dd if=/dev/zero of="$IMGDIR/drivep.dsk" bs=1 seek=536870911 count=1
if [ -n "$FSIMG" ] && [ -f "$FSIMG" ]; then
    dd if="$FSIMG" of="$IMGDIR/drivep.dsk" conv=notrunc
    echo "Root filesystem written from: $FSIMG"
else
    echo "WARNING: no root filesystem image supplied (set -DFUZIX_FILESYS_IMG=...);"
    echo "         drivep.dsk is blank 512MB."
fi

echo "Disk images ready in $IMGDIR: boot.dsk, drivep.dsk"
