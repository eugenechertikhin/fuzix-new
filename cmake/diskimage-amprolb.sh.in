#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Builds the amprolb (Ampro Little Board)
# disk image. Mirrors platform-amprolb/Makefile's cpmboot/image/diskimage rules:
#
#   cpmboot.s -> sdasz80 -> sdldz80 -i -> makebin, drop 256B -> cpmboot.com
#   fuzix.rom = low 32K of fuzix.bin (the ROM image)
#   diskstrap = fuzix.bin from 33280 (past the 32K + 512B loader hole)
#   cpmboot.com += diskstrap  (CP/M loadable kernel)
#   disk.img  = [40MB partition table] + root fs @ sector 2048 + diskstrap @ 2
#
# The 40MB partition-table base image defaults to the bundled parttab.40M; the
# root filesystem comes from -DFUZIX_FILESYS_IMG=... (or the rootfs target).
# ---------------------------------------------------------------------------
set -e

AS='@FUZIX_AS@'
LD='@FUZIX_LD@'
MAKEBIN='@MAKEBIN_BIN@'
PLATDIR='@PLATFORM_DIR@'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FSIMG='@FUZIX_FILESYS_IMG@'
PARTTAB='@FUZIX_PARTTAB@'
WORK='@DISKIMAGE_WORK@'
DISK="$IMGDIR/disk.img"

mkdir -p "$IMGDIR" "$WORK"
cd "$WORK"

# 1. CP/M bootstrap loader.
"$AS" -plosff -o cpmboot.rel "$PLATDIR/cpmboot.s"
"$LD" -i cpmboot.rel
"$MAKEBIN" -s 65535 cpmboot.ihx cpmboot.tmp
dd if=cpmboot.tmp of=cpmboot.com bs=256 skip=1

# 2. Split the kernel: low 32K -> ROM, the rest (past the 512B loader hole) -> diskstrap.
dd if="$KIMAGE" of=fuzix.rom  bs=32768 count=1
dd if="$KIMAGE" of=diskstrap  bs=33280 count=1 skip=1
cat diskstrap >> cpmboot.com
cp cpmboot.com fuzix.rom "$IMGDIR/"

# 3. Base disk: partition table if supplied, else a blank 40MB image.
if [ -n "$PARTTAB" ] && [ -f "$PARTTAB" ]; then
    dd if="$PARTTAB" of="$DISK" bs=40017920 conv=sync
else
    echo "WARNING: no partition table (set -DFUZIX_PARTTAB=...); using a blank 40MB image."
    dd if=/dev/zero of="$DISK" bs=1 seek=40017919 count=1
fi

# 4. Root filesystem at sector 2048, kernel disk part at sector 2.
if [ -n "$FSIMG" ] && [ -f "$FSIMG" ]; then
    dd if="$FSIMG" of="$DISK" bs=512 seek=2048 conv=notrunc
    echo "Root filesystem written from: $FSIMG"
else
    echo "WARNING: no root filesystem image (set -DFUZIX_FILESYS_IMG=... or -DFUZIX_ROOTFS=ON)."
fi
dd if=diskstrap of="$DISK" bs=512 seek=2 conv=notrunc

echo "Disk image ready: $DISK (+ cpmboot.com, fuzix.rom in $IMGDIR)"
