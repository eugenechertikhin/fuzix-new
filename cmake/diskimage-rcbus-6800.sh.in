#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Builds the rcbus-6800 IDE disk image.
# Mirrors platform-rcbus-6800/Makefile's loader + diskimage rules:
#
#   loader.S  -> assembled, linked at 0x0000 (-Z 0xF0), whole image
#   fuzix.bin -> kernel, first 256 bytes dropped (fuzix.img)
#   disk.img  = [40MB partition table] + loader @ sector 0 + kernel @ sector 1
#               + root filesystem @ sector 2048
#   emu-ide.img = idehdr.40M prepended to disk.img (emulator IDE image)
#
# The 40MB partition-table base image defaults to the bundled parttab.40M; the
# root filesystem comes from -DFUZIX_FILESYS_IMG=... (or the rootfs target).
# ---------------------------------------------------------------------------
set -e

CC='@FUZIX_CC@'
LD='@FUZIX_LD@'
MACH='@CPU_MACHINE@'
PLATDIR='@PLATFORM_DIR@'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FSIMG='@FUZIX_FILESYS_IMG@'
PARTTAB='@FUZIX_PARTTAB@'
IDEHDR='@FUZIX_IDEHDR@'
WORK='@DISKIMAGE_WORK@'
DISK="$IMGDIR/disk.img"

mkdir -p "$IMGDIR" "$WORK"
cd "$WORK"

# 1. Build the bootstrap loader (linked at 0x0000, keep the whole image).
"$CC" -X "$MACH" -c "$PLATDIR/loader.S"
# -o (like all ld options) MUST precede the input objects: once the linker sees
# a non-option filename it stops parsing flags.
"$LD" -b -C 0x0000 -Z 0xF0 -o loader.bin loader.o

# 2. Kernel image without its low 256 bytes.
dd if="$KIMAGE" of=fuzix.img bs=256 skip=1

# 3. Base disk: partition table if supplied, else a blank 40MB image.
if [ -n "$PARTTAB" ] && [ -f "$PARTTAB" ]; then
    dd if="$PARTTAB" of="$DISK" bs=40017920 conv=sync
else
    echo "WARNING: no partition table (set -DFUZIX_PARTTAB=...); using a blank 40MB image."
    dd if=/dev/zero of="$DISK" bs=1 seek=40017919 count=1
fi

# 4. Loader at sector 0, kernel at sector 1, filesystem at sector 2048.
dd if=loader.bin of="$DISK" conv=notrunc
dd if=fuzix.img  of="$DISK" bs=512 seek=1 conv=notrunc
if [ -n "$FSIMG" ] && [ -f "$FSIMG" ]; then
    dd if="$FSIMG" of="$DISK" bs=512 seek=2048 conv=notrunc
    echo "Root filesystem written from: $FSIMG"
else
    echo "WARNING: no root filesystem image (set -DFUZIX_FILESYS_IMG=... or -DFUZIX_ROOTFS=ON)."
fi

# 5. Emulator IDE image (idehdr prepended), if the header asset is present.
if [ -n "$IDEHDR" ] && [ -f "$IDEHDR" ]; then
    cat "$IDEHDR" "$DISK" > "$IMGDIR/emu-ide.img"
    echo "Emulator IDE image: $IMGDIR/emu-ide.img"
fi

echo "Disk image ready: $DISK"
