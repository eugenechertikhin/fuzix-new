#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Builds the Z80-2063 SD disk image.
# Mirrors platform-2063/Makefile's `image` + `diskimage` rules:
#
#   boot.s   -> sdasz80 -> sdldz80 -i -> makebin, keep the 0xFE00 page (512B)
#   disk.img = [20MB base with partition table] with, inside the partition:
#              filesystem @ sector 2048, kernel @ sector 1, boot block @ 2048/0
#
# The 20MB partition-table base image defaults to the bundled parttab.20M; the
# root filesystem comes from -DFUZIX_FILESYS_IMG=... (or the rootfs target).
# ---------------------------------------------------------------------------
set -e

AS='@FUZIX_AS@'
LD='@FUZIX_LD@'
MAKEBIN='@MAKEBIN_BIN@'
PLATDIR='@PLATFORM_DIR@'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FSIMG='@FUZIX_FILESYS_IMG@'
PARTTAB='@FUZIX_PARTTAB@'
WORK='@DISKIMAGE_WORK@'
DISK="$IMGDIR/disk.img"

mkdir -p "$IMGDIR" "$WORK"
cd "$WORK"

# 1. Build the SD bootstrap (assembled at 0xFE00, keep that 512-byte page).
"$AS" -plosff -o boot.rel "$PLATDIR/boot.s"
"$LD" -i boot.rel
"$MAKEBIN" -s 65536 boot.ihx | dd of=boot.bin bs=256 skip=254

# 2. Base disk: 20MB image fronted by the partition table.
if [ -n "$PARTTAB" ] && [ -f "$PARTTAB" ]; then
    dd if="$PARTTAB" of="$DISK" bs=20152320 conv=sync
else
    echo "WARNING: no partition table (set -DFUZIX_PARTTAB=...); using a blank 20MB image."
    dd if=/dev/zero of="$DISK" bs=1 seek=20152319 count=1
fi

# 3. Root filesystem at sector 2048 (start of the partition), if provided.
if [ -n "$FSIMG" ] && [ -f "$FSIMG" ]; then
    dd if="$FSIMG" of="$DISK" bs=512 seek=2048 conv=notrunc
    echo "Root filesystem written from: $FSIMG"
else
    echo "WARNING: no root filesystem image (set -DFUZIX_FILESYS_IMG=... or -DFUZIX_ROOTFS=ON)."
fi

# 4. Kernel at sector 1, boot block at block 0 of the partition (sector 2048).
dd if="$KIMAGE" of="$DISK" bs=512 seek=1 conv=notrunc
dd if=boot.bin  of="$DISK" bs=512 count=1 seek=2048 conv=notrunc

echo "Disk image ready: $DISK"
