#!/bin/sh
# ---------------------------------------------------------------------------
# Link + pack the classic SDCC Z80 kernel image.
#
# Generated by CMake (configure_file) from cmake/link-image-sdcc.sh.in.
# Invoked as:  link-image.sh <obj1.o> <obj2.o> ...   (in fuzix.lnk order)
#
#   1. write a sdldz80 command file (.lnk) with the bank base addresses and the
#      ordered object list, then link -> fuzix.ihx + fuzix.map
#   2. makebin -p           : Intel HEX -> flat 64K image (packed)
#   3. binman + fuzix.map    : relocate INITIALIZER->INITIALIZED, pack common
#                              memory, trim -> fuzix.bin
# ---------------------------------------------------------------------------
set -e

IMG="@FUZIX_IMAGE_DIR@"
LNK="$IMG/fuzix.lnk"

: > "$LNK"
printf -- '-mwxuy\n'            >> "$LNK"
printf -- '-i fuzix.ihx\n'      >> "$LNK"
for b in @LINK_SDCC_BASES_STR@ ; do
    printf -- '-b %s\n' "$b"    >> "$LNK"
done
printf -- '-l @CPU_LIB_NAME@\n' >> "$LNK"
for o in "$@" ; do
    echo "$o"                   >> "$LNK"
done
printf -- '-e\n'                >> "$LNK"

cd "$IMG"
"@FUZIX_LD@" -n -k "@CPU_LIB_DIR@" -f "$LNK"

"@MAKEBIN_BIN@" -s 65536 -p fuzix.ihx > fuzix.tmp
"@BINMAN_BIN@" fuzix.tmp fuzix.map fuzix.bin
