#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Links the Fuzix kernel image for the
# z8 (fcc) target. Unlike the 8080/8085/z80 flow there is NO pack85 step:
# ldz8 emits the final loadable binary directly (matching platform-rcbus-z8's
# Makefile `image` rule, which just `cp`s the linker output).
#
#   ldz8   -> loadable binary + symbol map   (flags are platform-specific)
#   perl   -> sort the map by address
#
# Object files are passed as arguments in link order (crt0 first).
# ---------------------------------------------------------------------------
set -e

LD='@FUZIX_LD@'
LIBC='@FUZIX_LIBC@'
OUTDIR='@FUZIX_IMAGE_DIR@'

cd "$OUTDIR"

# 1. Link (platform-specific origin/split/discard flags). All options must
# precede the object/library operands (BSD getopt stops at the first operand).
"$LD" @LINK_FLAGS_STR@ -o fuzix.bin -m fuzix.tmpmap "$@" "$LIBC"

# 2. Sort the symbol map numerically by (hex) address.
perl -lpe '$_=hex' fuzix.tmpmap | paste -d' ' - fuzix.tmpmap | sort -n | cut -d' ' -f 2- > fuzix.map

echo "Built kernel image: $OUTDIR/fuzix.bin"
