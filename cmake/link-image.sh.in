#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Links the Fuzix kernel image for the
# selected CPU/platform:
#   <ld>   -> raw binary + symbol map     (flags are platform-specific)
#   perl   -> sort the map by address
#   pack85 -> pack into the final loadable kernel image
#
# Object files are passed as arguments in link order (crt0 first).
# ---------------------------------------------------------------------------
set -e

LD='@FUZIX_LD@'
LIBC='@FUZIX_LIBC@'
PACK85='@PACK85_BIN@'
OUTDIR='@FUZIX_IMAGE_DIR@'

cd "$OUTDIR"

# 1. Link (platform-specific origin/split/discard flags).
# All options must precede the object/library operands: a BSD/macOS getopt()
# (unlike glibc) stops scanning at the first non-option, so a trailing
# "-m fuzix.tmpmap" would be mistaken for input files.
"$LD" @LINK_FLAGS_STR@ -o fuzix.raw -m fuzix.tmpmap "$@" "$LIBC"

# 2. Sort the symbol map numerically by (hex) address.
perl -lpe '$_=hex' fuzix.tmpmap | paste -d' ' - fuzix.tmpmap | sort -n | cut -d' ' -f 2- > fuzix.map

# 3. Pack into the final loadable image.
"$PACK85" < fuzix.map fuzix.raw fuzix.bin

echo "Built kernel image: $OUTDIR/fuzix.bin"
