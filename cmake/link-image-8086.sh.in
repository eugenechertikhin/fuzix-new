#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Links the Intel 8086 kernel image.
# Mirrors platform-ibmpc/Makefile's image rule:
#   ia16-elf-ld -M -o fuzix.elf -T fuzix.ld  -> ELF kernel image
#
# Unlike the PDP-11 flow there is no objcopy step: the ELF *is* the deliverable
# upstream. We additionally copy it to fuzix.bin so the standard `fuzix` /
# diskimage plumbing (which tracks fuzix.bin) is satisfied.
#
# Object files are passed as arguments (crt0 is pulled first by STARTUP()).
# ---------------------------------------------------------------------------
set -e

LD='@FUZIX_LD@'
LDSCRIPT='@LINK_SCRIPT@'
OUTDIR='@FUZIX_IMAGE_DIR@'

cd "$OUTDIR"

"$LD" -M -o fuzix.elf -T "$LDSCRIPT" "$@" > fuzix.map
cp fuzix.elf fuzix.bin

echo "Built kernel image: $OUTDIR/fuzix.elf"
