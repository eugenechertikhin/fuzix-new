#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Links the ARM Cortex-M4 kernel image.
# Mirrors platform-tm4c129x/Makefile's image rule:
#   arm-none-eabi-ld --entry=start -M -o fuzix.elf -T fuzix.ld <objs>
# ELF is the deliverable; also copied to fuzix.bin for the standard plumbing.
# ---------------------------------------------------------------------------
set -e
LD='@FUZIX_LD@'
LDSCRIPT='@LINK_SCRIPT@'
OUTDIR='@FUZIX_IMAGE_DIR@'
cd "$OUTDIR"
"$LD" --entry=start -M -o fuzix.elf -T "$LDSCRIPT" "$@" > fuzix.map
cp fuzix.elf fuzix.bin
echo "Built kernel image: $OUTDIR/fuzix.elf"
