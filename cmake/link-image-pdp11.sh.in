#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Links the PDP-11 kernel image.
# Mirrors platform-pdp11/Makefile's image rule:
#   pdp11-aout-ld -T fuzix.ld  -> a.out
#   pdp11-aout-objcopy -O binary -> flat kernel image
#
# Object files are passed as arguments (crt0 is pulled first by STARTUP()).
# ---------------------------------------------------------------------------
set -e

LD='@FUZIX_LD@'
OBJCOPY='@FUZIX_OBJCOPY@'
LDSCRIPT='@LINK_SCRIPT@'
OUTDIR='@FUZIX_IMAGE_DIR@'

cd "$OUTDIR"

"$LD" -M -o fuzix.aout -T "$LDSCRIPT" "$@" > fuzix.map
"$OBJCOPY" fuzix.aout -O binary fuzix.bin

echo "Built kernel image: $OUTDIR/fuzix.bin"
