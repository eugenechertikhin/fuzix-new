#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Builds the zxuno esxdos .hdf/.mmc image.
# Mirrors platform-zxuno/Makefile's `image` + `diskimage` rules:
#
#   load-esx.s -> sdasz80 -> sdldz80 -i -> makebin, drop the low 8K -> FUZIX
#   FUZIX.BIN  = fuzix.bin (loaded by the esx loader)
#   disk.hdf   = hdfstart header + a FAT16 partition (esxdos + FUZIX loader +
#                FUZIX.BIN) @ sector 2048, and the FUZIX root filesystem @ the
#                second partition. disk.mmc is the headerless variant.
#
# Needs mkfs_fat (host-built), hdfmonkey (on PATH or -DFUZIX_HDFMONKEY=...), and
# the ESXDOS distribution (toolchain/esxdos). The root filesystem comes from
# -DFUZIX_FILESYS_IMG=... (or the rootfs target).
# ---------------------------------------------------------------------------
set -e

AS='@FUZIX_AS@'
LD='@FUZIX_LD@'
MAKEBIN='@MAKEBIN_BIN@'
MKFS_FAT='@MKFS_FAT_BIN@'
HDFMONKEY='@FUZIX_HDFMONKEY@'
ESXDOS='@ESXDOS_DIR@'
PLATDIR='@PLATFORM_DIR@'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FSIMG='@FUZIX_FILESYS_IMG@'
HDFSTART='@PLATFORM_DIR@/hdfstart.bin'
WORK='@DISKIMAGE_WORK@'
HDF="$IMGDIR/disk.hdf"

mkdir -p "$IMGDIR" "$WORK"
cd "$WORK"

# 1. esxdos loader (runs at 0x2000, keep the image above the low 8K) -> FUZIX.
"$AS" -plosff -o load-esx.rel "$PLATDIR/load-esx.s"
"$LD" -i load-esx.rel
"$MAKEBIN" -s 16384 load-esx.ihx load-esx.tmp
dd if=load-esx.tmp of=FUZIX bs=8192 skip=1
cp "$KIMAGE" FUZIX.BIN

# 2. Base hdf image with its partition table, forced to ~128MB.
dd if="$HDFSTART" of="$HDF"
dd if=/dev/zero of="$HDF" bs=1 seek=134218261 count=1

# 3. FUZIX root filesystem into the second (fuzix) partition, if provided.
if [ -n "$FSIMG" ] && [ -f "$FSIMG" ]; then
    dd if="$FSIMG" of="$HDF" bs=34603542 seek=1 conv=notrunc
    echo "Root filesystem written from: $FSIMG"
else
    echo "WARNING: no root filesystem image (set -DFUZIX_FILESYS_IMG=... or -DFUZIX_ROOTFS=ON)."
fi

# 4. FAT16 partition (esxdos + FUZIX) at sector 2048.
dd if=/dev/zero bs=512 count=65536 of=tmp.fat
"$MKFS_FAT" -F 16 -n FUZIX tmp.fat
dd if=tmp.fat of="$HDF" bs=1049110 seek=1 conv=notrunc

if command -v "$HDFMONKEY" >/dev/null 2>&1; then
    for f in "$ESXDOS"/*; do "$HDFMONKEY" put "$HDF" "$f" /; done
    "$HDFMONKEY" put "$HDF" FUZIX.BIN FUZIX.BIN
    "$HDFMONKEY" put "$HDF" FUZIX BIN/FUZIX
    dd if="$HDF" of="$IMGDIR/disk.mmc" bs=534 skip=1
    echo "esxdos hdf image ready: $HDF (+ disk.mmc)"
else
    echo "WARNING: hdfmonkey not found (set -DFUZIX_HDFMONKEY=...); wrote the raw"
    echo "         hdf with the FUZIX fs + FAT partition but no esxdos/kernel files."
fi

echo "Disk image ready: $HDF"
