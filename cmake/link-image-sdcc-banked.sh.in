#!/bin/sh
# ---------------------------------------------------------------------------
# Link + pack a BANKED SDCC Z80 kernel (ZX Spectrum overlapping code banks).
#
# Generated by CMake (configure_file) from link-image-sdcc-banked.sh.in.
# Invoked as:  link-image.sh <obj1.o> <obj2.o> ...   (in fuzix.lnk order)
#
#   1. write a bankld command file (.lnk) with -r + the overlapping bank base
#      addresses, link with the host-built bank-aware sdldz80 -> a bank-tagged
#      fuzix.ihx + fuzix.map
#   2. bihx splits the tagged ihx into common.ihx + bank<N>.ihx and makebin's
#      each into common.bin + bank<N>.bin
#   3. binman (fed the common image + map) -> fuzix.bin (flat, for disk boards)
#   4. bin2sna / bin2z80 assemble the 128K snapshots from the bank binaries
# ---------------------------------------------------------------------------
set -e

IMG="@FUZIX_IMAGE_DIR@"
LNK="$IMG/fuzix.lnk"
# bihx shells out to `makebin`; make sure the SDCC bin dir is on PATH.
PATH="@FUZIX_TOOLCHAIN_PREFIX@/bin:$PATH"
export PATH

: > "$LNK"
printf -- '-mwxuy\n'            >> "$LNK"
for f in @LINK_SDCC_FLAGS@ ; do printf -- '%s\n' "$f" >> "$LNK"; done
printf -- '-i fuzix.ihx\n'      >> "$LNK"
for b in @LINK_SDCC_BASES_STR@ ; do printf -- '-b %s\n' "$b" >> "$LNK"; done
printf -- '-l @CPU_LIB_NAME@\n' >> "$LNK"
for o in "$@" ; do echo "$o"    >> "$LNK"; done
printf -- '-e\n'                >> "$LNK"

cd "$IMG"
"@FUZIX_LD@" -n -k "@CPU_LIB_DIR@" -f "$LNK"

# Split the bank-tagged ihx into common.ihx + bank<N>.ihx (+ .bin via makebin).
"@BIHX_BIN@" fuzix.ihx

# Flat image for disk-based boards.
"@MAKEBIN_BIN@" -s 65536 -p common.ihx > fuzix.tmp
"@BINMAN_BIN@" fuzix.tmp fuzix.map fuzix.bin

# 128K snapshots (read common.bin + bank<N>.bin from this dir).
"@BIN2SNA_BIN@" fuzix.sna || echo "WARNING: bin2sna failed (snapshot skipped)"
"@BIN2Z80_BIN@" fuzix.z80 || echo "WARNING: bin2z80 failed (snapshot skipped)"
