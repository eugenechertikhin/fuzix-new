#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Links the ESP8266 (Xtensa LX106) kernel
# image. Mirrors platform-esp8266/Makefile's image.elf rule:
#
#   xtensa-lx106-elf-gcc -T kernel.ld -T addresses.ld -flto -mlongcalls \
#       -nostdlib -o image.elf $(KOBJS)
#
# The link is driven by the C compiler (not ld directly) so LTO can run, and
# uses TWO linker scripts: kernel.ld (memory map / sections) + addresses.ld
# (ESP8266 ROM symbol PROVIDE()s). The ELF is the deliverable (esptool
# elf2image is a downstream flashing step outside CMake). We also copy it to
# fuzix.bin so the standard `fuzix` / diskimage plumbing (which tracks
# fuzix.bin) is satisfied.
#
# Object files are passed as arguments.
# ---------------------------------------------------------------------------
set -e

CC='@FUZIX_CC@'
LDSCRIPT='@LINK_SCRIPT@'
LDSCRIPT2='@LINK_SCRIPT2@'
OUTDIR='@FUZIX_IMAGE_DIR@'

cd "$OUTDIR"

# -lgcc: with -nostdlib libgcc is not auto-linked, but modern gcc emits calls to
# its helpers (e.g. __bswapsi2 from the Dhara byte-swap). Upstream's older gcc /
# lx106 libgcc did not need it explicitly; we do.
"$CC" -T "$LDSCRIPT" -T "$LDSCRIPT2" -flto -mlongcalls -nostdlib \
      -o fuzix.elf "$@" -lgcc
cp fuzix.elf fuzix.bin

echo "Built kernel image: $OUTDIR/fuzix.elf"
