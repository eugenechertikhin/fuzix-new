#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake. Builds the IBM PC (i8086) root disk image for FUZIX.
#
# ibmpc is build-testing only upstream (no boot sector / loader), so unlike
# v8080 there is no bootable floppy to assemble - only the root hard-disk half
# of v8080's diskimage rule applies. This produces:
#
#   hd0.img  - a FUZIX filesystem populated with the i8086 userland (this IS
#              the BIOS/hda disk image the kernel's biosdisk driver would read):
#              /init, /bin/*, /dev nodes, /etc skeleton, /usr/lib/liberror.txt.
#   fuzix.elf - a copy of the linked kernel image, next to the disk.
#
# Populate flow mirrors the armm0 flashimage:  mkfs -> ucp -> fsck.
# ---------------------------------------------------------------------------
set -e

MKFS='@MKFS_BIN@'
UCP='@UCP_BIN@'
FSCK='@FSCK_BIN@'
BINDIR='@USER_BIN_DIR@'
ETCDIR='@ETC_DIR@'
LIBERROR='@USER_LIB_DIR@/liberror.txt'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FS_ISIZE=@DISKIMAGE_FS_ISIZE@
FS_BSIZE=@DISKIMAGE_FS_BSIZE@

mkdir -p "$IMGDIR"
cd "$IMGDIR"
IMG=hd0.img
rm -f "$IMG"

"$MKFS" "$IMG" "$FS_ISIZE" "$FS_BSIZE"

# Build the ucp population script: skeleton dirs + /dev nodes, then every built
# binary, the /etc skeleton and liberror.txt.
{
cat <<'SKEL'
cd /
mkdir bin
mkdir dev
mkdir etc
mkdir mnt
mkdir root
mkdir tmp
mkdir usr
mkdir var
chmod 0755 /
chmod 0755 bin
chmod 0755 dev
chmod 01777 tmp
chmod 0755 usr
chmod 0755 var
chmod 0700 root
mkdir /usr/lib
chmod 0755 /usr/lib
mkdir /var/run
cd /dev
mknod tty     20666 512
mknod tty1    20660 513
mknod tty2    20660 514
mknod console 20660 512
mknod null    20666 1024
mknod kmem    20660 1025
mknod zero    20444 1026
mknod proc    20666 1027
mknod mem     20660 1028
mknod rtc     20600 1029
mknod hda     60660 0
mknod hda1    60660 1
SKEL

# /init (first program the kernel runs) lives at the root.
if [ -f "$BINDIR/init" ]; then
    echo "cd /"
    echo "bget $BINDIR/init init"
    echo "chmod 0755 init"
fi

# Every other built binary -> /bin.
echo "cd /bin"
for f in "$BINDIR"/*; do
    [ -f "$f" ] || continue
    b=$(basename "$f")
    [ "$b" = init ] && continue
    echo "bget $f $b"
    echo "chmod 0755 $b"
done

# /etc skeleton.
echo "cd /etc"
for e in fstab group inittab motd mtab passwd; do
    [ -f "$ETCDIR/$e" ] && { echo "bget $ETCDIR/$e $e"; echo "chmod 0644 $e"; }
done
for e in rc rc.halt rc.reboot; do
    [ -f "$ETCDIR/$e" ] && { echo "bget $ETCDIR/$e $e"; echo "chmod 0755 $e"; }
done

# liberror.txt -> /usr/lib.
if [ -f "$LIBERROR" ]; then
    echo "cd /usr/lib"
    echo "bget $LIBERROR liberror.txt"
    echo "chmod 0644 liberror.txt"
fi
} | "$UCP" "$IMG"

"$FSCK" -a "$IMG" || true

# Keep the kernel image next to the disk for convenience.
[ -f "$KIMAGE" ] && cp "$KIMAGE" "$IMGDIR/fuzix.elf"

echo "Built IBM PC disk image: $IMGDIR/hd0.img (+ fuzix.elf)"
