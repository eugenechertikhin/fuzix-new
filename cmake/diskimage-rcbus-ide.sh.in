#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake (configure_file). Builds the rcbus-8080 IDE disk image.
# Mirrors platform-rcbus-8080/Makefile's loader + diskimage rules:
#
#   loader.S  -> assembled, linked at 0xFE00, last 256 bytes cut out
#   fuzix.bin -> kernel, first 256 bytes dropped
#   disk.img  = [partition table] + loader @ sector 0 + kernel @ sector 1
#               + root filesystem @ sector 2048
#
# The 40MB partition-table base image and the root filesystem live outside
# this kernel tree; pass them with -DFUZIX_PARTTAB / -DFUZIX_FILESYS_IMG to get
# a bootable image. Without them a blank 40MB image is produced.
# ---------------------------------------------------------------------------
set -e

CC='@FUZIX_CC@'
LD='@FUZIX_LD@'
PLATDIR='@PLATFORM_DIR@'
IMGDIR='@FUZIX_IMAGES_DIR@'
KIMAGE='@FUZIX_IMAGE_DIR@/fuzix.bin'
FSIMG='@FUZIX_FILESYS_IMG@'
PARTTAB='@FUZIX_PARTTAB@'
WORK='@DISKIMAGE_WORK@'

mkdir -p "$IMGDIR" "$WORK"
cd "$WORK"

# 1. Build the bootstrap loader (linked high at 0xFE00, keep the last 256 bytes).
"$CC" -X -m8080 -c "$PLATDIR/loader.S"
"$LD" -b -C 0xFE00 loader.o -o loader.tmp
dd if=loader.tmp of=loader bs=256 skip=254

# 2. Kernel image without its low 256 bytes.
dd if="$KIMAGE" of=fuzix.img bs=256 skip=1

# 3. Base disk: partition table if supplied, else a blank 40MB image.
if [ -n "$PARTTAB" ] && [ -f "$PARTTAB" ]; then
    dd if="$PARTTAB" of="$IMGDIR/disk.img" bs=40017920 conv=sync
else
    echo "WARNING: no partition table (set -DFUZIX_PARTTAB=...); using a blank 40MB image."
    dd if=/dev/zero of="$IMGDIR/disk.img" bs=1 seek=40017919 count=1
fi

# 4. Loader at sector 0, kernel at sector 1, filesystem at sector 2048.
dd if=loader   of="$IMGDIR/disk.img" conv=notrunc
dd if=fuzix.img of="$IMGDIR/disk.img" bs=512 seek=1 conv=notrunc
if [ -n "$FSIMG" ] && [ -f "$FSIMG" ]; then
    dd if="$FSIMG" of="$IMGDIR/disk.img" bs=512 seek=2048 conv=notrunc
    echo "Root filesystem written from: $FSIMG"
else
    echo "WARNING: no root filesystem image (set -DFUZIX_FILESYS_IMG=...)."
fi

echo "Disk image ready: $IMGDIR/disk.img"
