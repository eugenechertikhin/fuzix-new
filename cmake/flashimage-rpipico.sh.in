#!/bin/sh
# ---------------------------------------------------------------------------
# Generated by CMake. Builds the Raspberry Pi Pico FLASH FILESYSTEM image for
# FUZIX/rpipico: a FUZIX fs populated with the armm0 userland, converted to a
# Dhara FTL image and packed as a .uf2 to flash at 0x10018000.
#
# Mirrors platform-rpipico/update-flash.sh but pulls binaries from the
# fuzix-new `bin` output (armm0 PIE ELF) instead of the upstream Applications/.
#
#   mkfs -> ucp (populate) -> fsck -> mkftl -> picotool uf2 convert
# ---------------------------------------------------------------------------
set -e

MKFS='@MKFS_BIN@'
UCP='@UCP_BIN@'
FSCK='@FSCK_BIN@'
MKFTL='@MKFTL_BIN@'
PICOTOOL='@PICOTOOL_BIN@'
BINDIR='@USER_BIN_DIR@'
ETCDIR='@ETC_DIR@'
LIBERROR='@USER_LIB_DIR@/liberror.txt'
OUTDIR='@FLASH_OUT_DIR@'
FSSIZE=@FLASH_FSSIZE@
FAMILY='@PICO_UF2_FAMILY@'
OFFSET=@PICO_UF2_OFFSET@

mkdir -p "$OUTDIR"
cd "$OUTDIR"
IMG=filesystem.img
rm -f "$IMG" filesystem.ftl filesystem.uf2

"$MKFS" "$IMG" 32 "$FSSIZE"

# Build the ucp population script: skeleton dirs + /dev nodes (from
# update-flash.sh), then every built binary, the /etc skeleton and liberror.txt.
{
cat <<'SKEL'
cd /
mkdir bin
mkdir dev
mkdir etc
mkdir mnt
mkdir root
mkdir tmp
mkdir usr
mkdir var
chmod 0755 /
chmod 0755 bin
chmod 0755 dev
chmod 01777 tmp
chmod 0755 usr
chmod 0755 var
chmod 0700 root
mkdir /usr/lib
chmod 0755 /usr/lib
mkdir /var/run
cd /dev
mknod tty   20666 512
mknod tty1  20660 513
mknod tty2  20660 514
mknod console 20660 512
mknod null  20666 1024
mknod kmem  20660 1025
mknod zero  20444 1026
mknod proc  20666 1027
mknod mem   20660 1028
mknod rtc   20600 1029
mknod hda   60660 0
mknod hda1  60660 1
SKEL

# /init (first program the kernel runs) lives at the root.
if [ -f "$BINDIR/init" ]; then
    echo "cd /"
    echo "bget $BINDIR/init init"
    echo "chmod 0755 init"
fi

# Every other built binary -> /bin.
echo "cd /bin"
for f in "$BINDIR"/*; do
    [ -f "$f" ] || continue
    b=$(basename "$f")
    [ "$b" = init ] && continue
    echo "bget $f $b"
    echo "chmod 0755 $b"
done

# /etc skeleton.
echo "cd /etc"
for e in fstab group inittab motd mtab passwd; do
    [ -f "$ETCDIR/$e" ] && { echo "bget $ETCDIR/$e $e"; echo "chmod 0644 $e"; }
done
for e in rc rc.halt rc.reboot; do
    [ -f "$ETCDIR/$e" ] && { echo "bget $ETCDIR/$e $e"; echo "chmod 0755 $e"; }
done

# liberror.txt -> /usr/lib.
if [ -f "$LIBERROR" ]; then
    echo "cd /usr/lib"
    echo "bget $LIBERROR liberror.txt"
    echo "chmod 0644 liberror.txt"
fi
} | "$UCP" "$IMG"

"$FSCK" -a "$IMG" || true

# Options must precede the input file: macOS getopt() does not permute args
# (unlike GNU getopt, which is why upstream update-flash.sh puts them after).
"$MKFTL" -s 1952 -e 0x1000 -g 10 -o filesystem.ftl "$IMG"
"$PICOTOOL" uf2 convert filesystem.ftl -t bin filesystem.uf2 -o "$OFFSET" --family "$FAMILY"

echo "Built flash filesystem image: $OUTDIR/filesystem.uf2 (flash @ $OFFSET)"
